{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Delegation Supervisor Task Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "changedFiles", "checks", "blockers"],
  "properties": {
    "status": { "type": "string", "enum": ["completed", "failed"] },
    "summary": { "type": "string", "minLength": 1 },
    "changedFiles": { "type": "array", "maxItems": 256, "items": { "type": "string" } },
    "checks": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "status", "details"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["passed", "failed", "not_run"] },
          "details": { "type": "string" }
        }
      }
    },
    "blockers": { "type": "array", "maxItems": 64, "items": { "type": "string" } }
  }
}
